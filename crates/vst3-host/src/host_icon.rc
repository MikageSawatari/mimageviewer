#include <winver.h>

101 ICON "../../../assets/effetune.ico"

// Standalone bridge metadata, not the mImageViewer release version. Source
// identity continues to identify the exact build; protocol v7 stays unchanged.
1 VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "mImageViewer Project\0"
            VALUE "FileDescription", "EffeTune (mImageViewer)\0"
            VALUE "FileVersion", "0.0.0.0\0"
            VALUE "InternalName", "mimageviewer-vst3-host\0"
            VALUE "OriginalFilename", "mimageviewer-vst3-host.exe\0"
            VALUE "ProductName", "EffeTune (mImageViewer)\0"
            VALUE "ProductVersion", "0.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
