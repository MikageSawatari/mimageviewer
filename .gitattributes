models/*.onnx filter=lfs diff=lfs merge=lfs -text

# FFmpeg LGPL source mirror — keep byte-exact (no EOL conversion); the .asc GPG
# armored signature must stay LF or signature verification breaks on checkout.
htdocs/mimageviewer/ffmpeg-*-source.tar.xz binary
htdocs/mimageviewer/ffmpeg-*-source.tar.xz.asc binary

# Vendored hls.js — keep byte-exact so the sha256 in hls.VERSION.txt still
# verifies after a fresh checkout on Windows.
crates/remote-web/web/vendor/hls.min.js binary

# Apache は .htaccess をバイト列としてそのまま解釈するため、CRLF がディレクティブの
# 引数に紛れ込んで原因の分かりにくい 500 を招く。core.autocrlf に関わらず LF を保つ。
htdocs/mimageviewer/.htaccess text eol=lf
