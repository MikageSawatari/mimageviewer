models/*.onnx filter=lfs diff=lfs merge=lfs -text

# Full upstream notices: preserve the verbatim source bytes on checkout.
LIBRAW-LICENSE.txt -text
ZLIB-LICENSE.txt -text
LIBJPEG-TURBO-LICENSE.txt -text

# FFmpeg LGPL source mirror — keep byte-exact (no EOL conversion); the .asc GPG
# armored signature must stay LF or signature verification breaks on checkout.
htdocs/mimageviewer/ffmpeg-*-source.tar.xz binary
htdocs/mimageviewer/ffmpeg-*-source.tar.xz.asc binary

# Vendored hls.js — keep byte-exact so the sha256 in hls.VERSION.txt still
# verifies after a fresh checkout on Windows.
crates/remote-web/web/vendor/hls.min.js binary

# Apache は .htaccess をバイト列としてそのまま解釈するため、CRLF がディレクティブの
# 引数に紛れ込んで原因の分かりにくい 500 を招く。core.autocrlf に関わらず LF を保つ。
htdocs/mimageviewer/.htaccess text eol=lf

# sitemap.xml is generated with LF by scripts/gen-sitemap-xml.py. Without this,
# core.autocrlf=true rewrites it to CRLF on checkout and --check then reports the
# file as out of date on every run.
htdocs/sitemap.xml text eol=lf

# The EffeTune snapshot converter checks generated HTML byte-for-byte.
htdocs/mimageviewer/manual/effetune/**/*.html text eol=lf

# Verbatim EffeTune notices and VERSION must match vendor bytes even when
# core.autocrlf=true. Their committed blobs are LF; never convert on checkout.
third_party/effetune-mixwright/** -text
# mIV supplemental notices are also verbatim license copies, outside the bundle.
third_party/effetune-mixwright/supplemental/NOTICES.txt -text
# Japanese upstream documentation and referenced images are verbatim snapshots.
third_party/effetune-docs/** -text
