# GridDeleteConcealMask.2 = Shift+F10 ; 選択中またはチェック済み画像の隠蔽マスクを削除する

[FsCommon] ; フルスクリーン共通
# FsToggleMetadata.1 = I ; 左右パネルの表示モードを切り替える
# FsToggleMetadata.2 = Tab ; 左右パネルの表示モードを切り替える
# FsBackToList = Backspace ; フルスクリーンを閉じて一覧へ戻る
# FsToggleWindowMode = F11 ; ウィンドウ表示と全画面表示を切り替える
# FsJumpFirst = Home ; 先頭の項目へ移動する
# FsJumpLast = End ; 末尾の項目へ移動する
# FsCtrlNavPrev = Ctrl+Up ; 前のフォルダまたは検索結果へ移動する
# FsCtrlNavNext = Ctrl+Down ; 次のフォルダまたは検索結果へ移動する
# FsSiblingPrev = Ctrl+PageUp ; 前の兄弟フォルダへ移動する
# FsSiblingNext = Ctrl+PageDown ; 次の兄弟フォルダへ移動する

[Rating] ; レーティング
# RatingItem1 = F1 ; 星1を付ける（アイテム）
# RatingItem2 = F2 ; 星2を付ける（アイテム）
# RatingItem3 = F3 ; 星3を付ける（アイテム）
# RatingItem4 = F4 ; 星4を付ける（アイテム）
# RatingItem5 = F5 ; 星5を付ける（アイテム）
# RatingItemClear = F6 ; レーティングを解除する（アイテム）
# RatingContainer1 = Shift+F1 ; 星1を付ける（コンテナ）
# RatingContainer2 = Shift+F2 ; 星2を付ける（コンテナ）
# RatingContainer3 = Shift+F3 ; 星3を付ける（コンテナ）
# RatingContainer4 = Shift+F4 ; 星4を付ける（コンテナ）
# RatingContainer5 = Shift+F5 ; 星5を付ける（コンテナ）
# RatingContainerClear = Shift+F6 ; レーティングを解除する（コンテナ）

[FsImage] ; 画像フルスクリーン
# FsClose = Enter ; 画像フルスクリーンを閉じる
# FsPagePrev = none ; 前のページへ移動する
# FsPageNext = none ; 次のページへ移動する
# FsFixedJumpPrev = Shift+Left ; 設定した量だけ前へジャンプする (右→左読みで反転)
# FsFixedJumpNext = Shift+Right ; 設定した量だけ先へジャンプする (右→左読みで反転)
# FsFixedJumpPrevNoRtl = PageUp ; 設定した量だけ前へジャンプする (右→左読みで反転しない)
# FsFixedJumpNextNoRtl = PageDown ; 設定した量だけ先へジャンプする (右→左読みで反転しない)
# FsStackJumpPrev = Shift+Up ; 前のスタックの先頭画像へジャンプする
# FsStackJumpNext = Shift+Down ; 次のスタックの先頭画像へジャンプする
# FsContinuousScrollForward = PageDown ; 連結表示中に次の画面分へスクロールする
# FsContinuousScrollBack = PageUp ; 連結表示中に前の画面分へスクロールする
# FsSpreadShiftLeft = Ctrl+Left ; 見開き表示を左方向へ1ページずらす
# FsSpreadShiftRight = Ctrl+Right ; 見開き表示を右方向へ1ページずらす
# FsSpreadShiftPrev = none ; 見開き表示を前のページ方向へ1ページずらす
# FsSpreadShiftNext = none ; 見開き表示を次のページ方向へ1ページずらす
# FsSlideshow = S ; スライドショーの再生または停止を切り替える
# FsSpaceCheck = Space ; 現在の画像のチェックを切り替える。スライドショー中は停止する
# FsCapture = Ctrl+S ; 現在の表示画像をキャプチャ保存する
# FsAddToActiveBook = Ctrl+B ; 現在のページを追加先の本へ追加する
# FsExport = Ctrl+E ; 現在の表示結果を別ファイルへ書き出す
# FsCompareToggle = X ; 現在の画像を比較スロットに固定または解除する
# FsCompareCycle = C ; 比較スロットのピン画像と現在画像を切り替えて表示する
# FsCompareWipe = Shift+C ; ワイプ比較を切り替える
# FsCompareDiff = Alt+C ; 差分比較を切り替える
# FsRotateCw = R ; 現在の画像を右に90度回転する
# FsRotateCcw = L ; 現在の画像を左に90度回転する
# FsImageAnalysis = Shift+Z ; 画像分析モードを開く
# FsZoomMode = Z ; 全画面ズームモード (押している間ズーム範囲を指定)
# FsPanorama = V ; 360度パノラマモードを切り替える
# FsPixelGrid = G ; ピクセルグリッド表示を切り替える
# FsLoupeLockToggle = M ; ルーペの固定表示を切り替える
# FsLoupeHold = Shift ; 押している間だけルーペを表示する
# FsEraseMode = E ; 消しゴムモードを開始または確定する
# FsLocalAdjustMode = Ctrl+G ; 補正レイヤーモードを開始する
# FsConcealMode = Ctrl+M ; 隠蔽加工モードを開始または終了する
# FsTextMode = Ctrl+T ; テキスト注釈モードを開始または終了する
# FsBookBookmark = B ; 現在の本のページにブックマークを追加する
# FsBgCycle = Shift+B ; 透過背景色を切り替える
# FsPin = P ; 現在の項目を代表サムネイルに固定または解除する
# FsSpreadSingle.1 = 1 ; 単ページ表示に切り替える
# FsSpreadSingle.2 = Numpad1 ; 単ページ表示に切り替える
# FsSpreadLtr.1 = 2 ; 左開き見開き表示に切り替える
# FsSpreadLtr.2 = Numpad2 ; 左開き見開き表示に切り替える
# FsSpreadLtrCover.1 = 3 ; 左開き表紙単独の見開き表示に切り替える
# FsSpreadLtrCover.2 = Numpad3 ; 左開き表紙単独の見開き表示に切り替える
# FsSpreadRtl.1 = 4 ; 右開き見開き表示に切り替える
# FsSpreadRtl.2 = Numpad4 ; 右開き見開き表示に切り替える
# FsSpreadRtlCover.1 = 5 ; 右開き表紙単独の見開き表示に切り替える
# FsSpreadRtlCover.2 = Numpad5 ; 右開き表紙単独の見開き表示に切り替える
# FsReadingFlowCycle.1 = 6 ; ページ単位/縦連結/横連結を切り替える
# FsReadingFlowCycle.2 = Numpad6 ; ページ単位/縦連結/横連結を切り替える
# FsReadingDirectionToggle.1 = 7 ; 横方向の読み進み方向を切り替える
# FsReadingDirectionToggle.2 = Numpad7 ; 横方向の読み進み方向を切り替える
# FsFitModeCycle.1 = 0 ; ズーム/フィット方式を切り替える
# FsFitModeCycle.2 = Numpad0 ; ズーム/フィット方式を切り替える
# FsAiModelNext = U ; AIモデルを次へ切り替える
# FsAiModelPrev = Shift+U ; AIモデルを前へ切り替える
# FsAiModelReset = Alt+U ; AIモデルを標準に戻す
# FsAiModelAuto = none ; AIモデルを自動（画像タイプ判別）にする
# FsAiModelRealEsrganX4Plus = none ; AIモデルを写真・CG（ノイズ除去強）にする
# FsAiModelRealEsrganAnime6B = none ; AIモデルをイラスト・アニメにする
# FsAiModelRealCugan4x = none ; AIモデルを漫画（トーン保持）にする
# FsAiModelNmkdSiax4x = none ; AIモデルを写真（質感保持）にする
# FsAiModelRealEsrGeneralV3 = none ; AIモデルを高速汎用にする
# FsDenoiseCycle = N ; デノイズ設定を切り替える
# FsPostFilterNext = T ; ポストフィルタを次へ切り替える
# FsPostFilterPrev = Shift+T ; ポストフィルタを前へ切り替える
# FsPostFilterReset = Alt+T ; ポストフィルタを標準に戻す
# FsPostFilterNearest = none ; ポストフィルタをニアレスト（補間なし）にする
# FsPostFilterCrtSimple = none ; ポストフィルタをCRT シンプル（控えめ）にする
# FsPostFilterCrtFull = none ; ポストフィルタをCRT フル（歪み+強グロー）にする
# FsPostFilterCrtArcade = none ; ポストフィルタをCRT アーケード（高コントラスト）にする
# FsPostFilterDither1bit = none ; ポストフィルタを1bit ディザにする
# FsPostFilterGameBoy = none ; ポストフィルタをGameBoy（緑4階調）にする
# FsPostFilterPc98 = none ; ポストフィルタをPC-98（16色・適応）にする
# FsPostFilterGameGear = none ; ポストフィルタをゲームギア（32色・12bit）にする
# FsPostFilterFamicom = none ; ポストフィルタをファミコン（52色・固定）にする
# FsPostFilterMegaDrive = none ; ポストフィルタをメガドライブ（61色・9bit）にする
# FsPostFilterMsx2Plus = none ; ポストフィルタをMSX2+（256色・GRB）にする
# FsPostFilterSfc = none ; ポストフィルタをスーパーファミコン（256色・15bit）にする
# FsPostFilterComboFamicomCrt = none ; ポストフィルタをCRT × ファミコンにする
# FsPostFilterComboPc98Crt = none ; ポストフィルタをCRT × PC-98にする
# FsPostFilterComboMsx2PlusCrt = none ; ポストフィルタをCRT × MSX2+にする
# FsPostFilterComboMegaDriveCrt = none ; ポストフィルタをCRT × メガドライブにする
# FsPostFilterComboSfcCrt = none ; ポストフィルタをCRT × スーパーファミコンにする
# FsPostFilterSepia = none ; ポストフィルタをセピアにする
# FsPostFilterMonoNeutral = none ; ポストフィルタをモノクロ（ニュートラル）にする
# FsPostFilterMonoCool = none ; ポストフィルタをモノクロ（冷調）にする
# FsPostFilterMonoWarm = none ; ポストフィルタをモノクロ（暖調）にする
# FsPostFilterWarmTone = none ; ポストフィルタを暖色調にする
# FsPostFilterCoolTone = none ; ポストフィルタを寒色調にする
# FsPostFilterTealOrange = none ; ポストフィルタをTeal & Orange（シネマ調）にする
# FsPostFilterKodakPortra = none ; ポストフィルタをKodak Portra 風にする
# FsPostFilterFujiVelvia = none ; ポストフィルタをFuji Velvia 風にする
# FsPostFilterBleachBypass = none ; ポストフィルタをブリーチバイパスにする
# FsPostFilterCrossProcess = none ; ポストフィルタをクロスプロセスにする
# FsPostFilterVintage = none ; ポストフィルタをビンテージ / 褪色にする
# FsPostFilterFilmGrain = none ; ポストフィルタをフィルムグレインにする
# FsPostFilterVignette = none ; ポストフィルタをビネット（周辺減光）にする
# FsPostFilterLightLeak = none ; ポストフィルタをライトリークにする
# FsPostFilterSoftFocus = none ; ポストフィルタをソフトフォーカスにする
# FsPostFilterHalftone = none ; ポストフィルタをハーフトーン（漫画風）にする
# FsPostFilterOilPaint = none ; ポストフィルタをオイルペイント風にする
# FsPostFilterSketch = none ; ポストフィルタをスケッチ風にする
# FsPostFilterPseudoColor4 = none ; カラー化を4色刷り（従来互換）にする
# FsPostFilterPseudoColorSkin = none ; カラー化を肌色（従来互換）にする
# FsPostFilterSharpen = none ; ポストフィルタをシャープ化にする
