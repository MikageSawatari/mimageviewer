# mimageviewer keymap.ini.default
#
# 上級者向けのキーボード割り当て設定です。
# 参照用です。このファイルは編集しないでください。
# アプリ内蔵の既定キーが変わると mimageviewer がこのファイルを上書きします。
# 変更したい行は keymap.ini へコピーするか、keymap.ini 側の同じ行を編集してください。
# keymap.ini は起動時に 1 回だけ読み込まれます。
#
# 書式:
# - 下のキー定義行はすべてコメントアウトされています。
# - コメントアウトされた行は、内蔵の既定キーに追従します。
# - 1 つの Action でもコメント解除すると、その Action の既定キーは全置換されます。
# - 既定キーを残したい場合は、残したいキーも Action.1..3 として明示してください。
# - 1 つの Action には Action.1 / Action.2 / Action.3 で最大 3 個まで割り当てできます。
# - none を指定すると、その Action を無効化できます。
# - 行末の ; 以降は説明コメントです。コメント解除後も残してかまいません。
# - 競合は検出しません。競合時は先に判定された操作が有効になります。
# - 通常の押下操作は Ctrl/Shift/Alt + 通常キーを指定できます。
# - ModifierHold は Ctrl / Shift / Alt のいずれか 1 つだけ指定できます。
# - KeyHold は修飾キーなしの通常キー 1 つだけ指定できます。
# - キー名の例: A..Z, 0..9, F1..F12, Left, Right, Up, Down,
#   Home, End, PageUp, PageDown, Space, Enter, Esc, Tab, Backspace, Delete, [, ], -
# - テンキー数字は通常の数字キーと同じ扱いです。
#   Numpad1 などの名前は受け付けますが、1 の別キーとしては使えません。
# - Alt+F4 / Alt+Tab / Alt+Esc / Alt+Space / Ctrl+Alt+Del / Win キー系など、
#   OS が予約しているショートカットは keymap.ini では上書きできません。
# - native 動画フルスクリーンでは Alt を含む組み合わせはアプリ側へ転送されません。
# - マウス、ゲームパッド、ドラッグ&ドロップ、OS/egui のコピー/切り取り/貼り付け、
#   IME 確定、右クリックメニュー、Escape/Enter ナビゲーション、多くの矢印ナビゲーションは固定です。
#
# 例:
# [FsImage]
# FsSlideshow.1 = P      ; スライドショーを P に変更
# FsSlideshow.2 = S      ; S も残したい場合は明示的に併記
# FsCapture = none       ; キャプチャ保存キーを無効化
# FsLoupeLockToggle = L  ; ルーペ固定表示のトグルを L に変更
# FsLoupeHold = Ctrl     ; 押している間だけルーペ表示する修飾キーを Ctrl に変更
#
# [Rating]
# RatingItem1 = Ctrl+F1  ; 現在の画像または動画に星1を付ける
#
# [Text]
# TextRedo.1 = Ctrl+Y        ; やり直し
# TextRedo.2 = Ctrl+Shift+Z  ; やり直しの別割り当て

[Global] ; 全体共通
# GlobalLocalSearch = Ctrl+F ; 現在地の一覧を絞り込み検索する
# GlobalFavSearch = Ctrl+S ; お気に入りフォルダを横断検索する
# GlobalMetadataSearch = Ctrl+G ; 全フォルダのメタデータを検索する
# GlobalOpenFolder = Ctrl+O ; フォルダを開くダイアログを表示する
# ToggleDetachedViewerMode = F12 ; 画像・動画ビューアの別ウィンドウモードを切り替える

[Grid] ; サムネイル一覧
# GridSelectAll = Ctrl+A ; 表示中のチェック可能な項目をすべてチェックする
# GridDeselect.1 = Ctrl+D ; チェックをすべて解除する
# GridDeselect.2 = Ctrl+Shift+A ; チェックをすべて解除する
# GridToggleCheck = Space ; 選択中の項目のチェックを切り替える
# GridDelete = Delete ; 選択中またはチェック済みの実ファイル/実フォルダを削除する
# GridToggleFolderTreePane = F ; フォルダツリーペインの表示を切り替える
# GridTagApply = T ; タグを付ける/外すダイアログを開く
# GridTagView = Ctrl+T ; タグビューを開く
# GridRotateCw = R ; 選択中の画像を右に90度回転する
# GridRotateCcw = L ; 選択中の画像を左に90度回転する
# GridPin = P ; 選択中の項目を代表サムネイルに固定または解除する
# GridComparePin = X ; 選択中の画像を比較スロットに固定または解除する
# GridAddToActiveBook = Ctrl+B ; 選択中またはチェック済みのページを追加先の本へ追加する
# GridColumnCount1 = Alt+1 ; サムネイル列数を1列にする
# GridColumnCount2 = Alt+2 ; サムネイル列数を2列にする
# GridColumnCount3 = Alt+3 ; サムネイル列数を3列にする
# GridColumnCount4 = Alt+4 ; サムネイル列数を4列にする
# GridColumnCount5 = Alt+5 ; サムネイル列数を5列にする
# GridColumnCount6 = Alt+6 ; サムネイル列数を6列にする
# GridColumnCount7 = Alt+7 ; サムネイル列数を7列にする
# GridColumnCount8 = Alt+8 ; サムネイル列数を8列にする
# GridColumnCount9 = Alt+9 ; サムネイル列数を9列にする
# GridColumnCount10 = Alt+0 ; サムネイル列数を10列にする
# GridToggleDetailsView = Alt+- ; サムネイル一覧と詳細一覧を切り替える
# GridAdjustSlot1 = Ctrl+1 ; 補正プリセットスロット1を適用する
# GridAdjustSlot2 = Ctrl+2 ; 補正プリセットスロット2を適用する
# GridAdjustSlot3 = Ctrl+3 ; 補正プリセットスロット3を適用する
# GridAdjustSlot4 = Ctrl+4 ; 補正プリセットスロット4を適用する
# GridAdjustSlot5 = Ctrl+5 ; 補正プリセットスロット5を適用する
# GridAdjustSlot6 = Ctrl+6 ; 補正プリセットスロット6を適用する
# GridAdjustSlot7 = Ctrl+7 ; 補正プリセットスロット7を適用する
# GridAdjustSlot8 = Ctrl+8 ; 補正プリセットスロット8を適用する
# GridAdjustSlot9 = Ctrl+9 ; 補正プリセットスロット9を適用する
# GridAdjustSlot10 = Ctrl+0 ; 補正プリセットスロット10を適用する
# GridClearAdjust.1 = Ctrl+Backspace ; 選択中の画像の補正を解除する
# GridClearAdjust.2 = Q ; 選択中の画像の補正を解除する

[FsCommon] ; フルスクリーン共通
# FsToggleMetadata.1 = I ; メタデータパネルの固定表示を切り替える
# FsToggleMetadata.2 = Tab ; メタデータパネルの固定表示を切り替える
# FsCtrlNavPrev = Ctrl+Up ; 前のフォルダまたは検索結果へ移動する
# FsCtrlNavNext = Ctrl+Down ; 次のフォルダまたは検索結果へ移動する
# FsSiblingPrev = Ctrl+PageUp ; 前の兄弟フォルダへ移動する
# FsSiblingNext = Ctrl+PageDown ; 次の兄弟フォルダへ移動する

[Rating] ; レーティング
# RatingItem1 = F1 ; 現在の画像または動画に星1を付ける
# RatingItem2 = F2 ; 現在の画像または動画に星2を付ける
# RatingItem3 = F3 ; 現在の画像または動画に星3を付ける
# RatingItem4 = F4 ; 現在の画像または動画に星4を付ける
# RatingItem5 = F5 ; 現在の画像または動画に星5を付ける
# RatingItemClear = F6 ; 現在の画像または動画のレーティングを解除する
# RatingContainer1 = Shift+F1 ; 現在のフォルダまたはZIP/PDF本体に星1を付ける
# RatingContainer2 = Shift+F2 ; 現在のフォルダまたはZIP/PDF本体に星2を付ける
# RatingContainer3 = Shift+F3 ; 現在のフォルダまたはZIP/PDF本体に星3を付ける
# RatingContainer4 = Shift+F4 ; 現在のフォルダまたはZIP/PDF本体に星4を付ける
# RatingContainer5 = Shift+F5 ; 現在のフォルダまたはZIP/PDF本体に星5を付ける
# RatingContainerClear = Shift+F6 ; 現在のフォルダまたはZIP/PDF本体のレーティングを解除する

[FsImage] ; 画像フルスクリーン
# FsFixedJumpPrev = Shift+Left ; 設定した量だけ前へジャンプする
# FsFixedJumpNext = Shift+Right ; 設定した量だけ先へジャンプする
# FsContinuousScrollForward = PageDown ; 連結表示中に次の画面分へスクロールする
# FsContinuousScrollBack = PageUp ; 連結表示中に前の画面分へスクロールする
# FsSpreadShiftLeft = Ctrl+Left ; 見開き表示を左方向へ1ページずらす
# FsSpreadShiftRight = Ctrl+Right ; 見開き表示を右方向へ1ページずらす
# FsSlideshow = S ; スライドショーの再生または停止を切り替える
# FsSpaceCheck = Space ; 現在の画像のチェックを切り替える。スライドショー中は停止する
# FsCapture = Ctrl+S ; 現在の表示画像をキャプチャ保存する
# FsAddToActiveBook = Ctrl+B ; 現在のページを追加先の本へ追加する
# FsExport = Ctrl+E ; 現在の表示結果を別ファイルへ書き出す
# FsCompareToggle = X ; 現在の画像を比較スロットに固定または解除する
# FsCompareCycle = C ; 比較スロットのピン画像と現在画像を切り替えて表示する
# FsCompareWipe = Shift+C ; ワイプ比較を切り替える
# FsCompareDiff = Alt+C ; 差分比較を切り替える
# FsRotateCw = R ; 現在の画像を右に90度回転する
# FsRotateCcw = L ; 現在の画像を左に90度回転する
# FsImageAnalysis = Shift+Z ; 画像分析モードを開く
# FsZoomMode = Z ; 全画面ズームモード (押している間ズーム範囲を指定)
# FsPanorama = V ; 360度パノラマモードを切り替える
# FsPixelGrid = G ; ピクセルグリッド表示を切り替える
# FsLoupeLockToggle = M ; ルーペの固定表示を切り替える
# FsLoupeHold = Shift ; 押している間だけルーペを表示する
# FsEraseMode = E ; 消しゴムモードを開始または確定する
# FsConcealMode = Ctrl+M ; 隠蔽加工モードを開始または終了する
# FsTextMode = Ctrl+T ; テキスト注釈モードを開始または終了する
# FsBgCycle = B ; 透過背景色を切り替える
# FsPin = P ; 現在の項目を代表サムネイルに固定または解除する
# FsSpreadSingle = 1 ; 単ページ表示に切り替える
# FsSpreadLtr = 2 ; 左開き見開き表示に切り替える
# FsSpreadLtrCover = 3 ; 左開き表紙単独の見開き表示に切り替える
# FsSpreadRtl = 4 ; 右開き見開き表示に切り替える
# FsSpreadRtlCover = 5 ; 右開き表紙単独の見開き表示に切り替える
# FsReadingFlowCycle = 6 ; ページ単位/縦連結/横連結を切り替える
# FsReadingDirectionToggle = 7 ; 横方向の読み進み方向を切り替える
# FsFitModeCycle = 0 ; ズーム/フィット方式を切り替える
# FsAiModelNext = U ; AIモデルを次へ切り替える
# FsAiModelPrev = Shift+U ; AIモデルを前へ切り替える
# FsAiModelReset = Alt+U ; AIモデルを標準に戻す
# FsDenoiseCycle = N ; デノイズ設定を切り替える
# FsPostFilterNext = T ; ポストフィルタを次へ切り替える
# FsPostFilterPrev = Shift+T ; ポストフィルタを前へ切り替える
# FsPostFilterReset = Alt+T ; ポストフィルタを標準に戻す
# FsAdjustSlot1 = Ctrl+1 ; 補正プリセットスロット1を適用する
# FsAdjustSlot2 = Ctrl+2 ; 補正プリセットスロット2を適用する
# FsAdjustSlot3 = Ctrl+3 ; 補正プリセットスロット3を適用する
# FsAdjustSlot4 = Ctrl+4 ; 補正プリセットスロット4を適用する
# FsAdjustSlot5 = Ctrl+5 ; 補正プリセットスロット5を適用する
# FsAdjustSlot6 = Ctrl+6 ; 補正プリセットスロット6を適用する
# FsAdjustSlot7 = Ctrl+7 ; 補正プリセットスロット7を適用する
# FsAdjustSlot8 = Ctrl+8 ; 補正プリセットスロット8を適用する
# FsAdjustSlot9 = Ctrl+9 ; 補正プリセットスロット9を適用する
# FsAdjustSlot10 = Ctrl+0 ; 補正プリセットスロット10を適用する
# FsClearAdjust.1 = Ctrl+Backspace ; 現在の画像の補正を解除する
# FsClearAdjust.2 = Q ; 現在の画像の補正を解除する
# FsApplyErase1 = F7 ; 消しゴムマスクスロット1を現在ページに適用する
# FsApplyErase2 = F8 ; 消しゴムマスクスロット2を現在ページに適用する
# FsApplyConceal1 = F9 ; 隠蔽マスクスロット1を現在ページに適用する
# FsApplyConceal2 = F10 ; 隠蔽マスクスロット2を現在ページに適用する
# FsDeleteEraseMask.1 = Shift+F7 ; 現在ページの消しゴムマスクを削除する
# FsDeleteEraseMask.2 = Shift+F8 ; 現在ページの消しゴムマスクを削除する
# FsDeleteConcealMask.1 = Shift+F9 ; 現在ページの隠蔽マスクを削除する
# FsDeleteConcealMask.2 = Shift+F10 ; 現在ページの隠蔽マスクを削除する

[FsVideo] ; 動画フルスクリーン
# VideoExternalPlayer = Shift+Enter ; 現在の動画を外部プレイヤーで開く
# VideoPlayPause.1 = Space ; 動画の再生または一時停止を切り替える
# VideoPlayPause.2 = Enter ; 動画の再生または一時停止を切り替える
# VideoSeekStart = W ; 動画の先頭へ移動して再生する
# VideoVolumeUp = Shift+Up ; 動画音量を上げる
# VideoVolumeDown = Shift+Down ; 動画音量を下げる
# VideoNextFile = Down ; 次のファイルへ移動する
# VideoPrevFile = Up ; 前のファイルへ移動する
# VideoMute = M ; 動画のミュートを切り替える
# VideoLoop = L ; 動画のループ方式を順に切り替える
# VideoMarkerPrev = J ; 前のチャプター/ブックマーク/ピンへ移動する
# VideoMarkerNext = K ; 次のチャプター/ブックマーク/ピンへ移動する
# VideoPin = P ; 現在の再生位置を代表フレームとしてピン留めする
# VideoPerfOverlay = F ; 動画の性能オーバーレイを切り替える
# VideoTileMode = S ; 動画タイルモードを切り替える
# VideoBookmark = B ; 現在の再生位置にブックマークを追加する
# VideoCapture = Ctrl+S ; 現在の動画フレームをキャプチャ保存する
# VideoAddToActiveBook = Ctrl+B ; 現在の動画フレームを追加先の本へ追加する
# VideoCompareToggle = X ; 動画では比較表示キーを何もしない操作として消費する
# VideoCompareCycle = C ; 動画では比較切り替えキーを何もしない操作として消費する
# VideoCompareWipe = Shift+C ; 動画ではワイプ比較キーを何もしない操作として消費する
# VideoCompareDiff = Alt+C ; 動画では差分比較キーを何もしない操作として消費する

[Erase] ; 消しゴムモード
# EraseConfirm = E ; 消しゴム処理を実行して終了する
# EraseUndo = Ctrl+Z ; 消しゴム編集を元に戻す
# EraseDeleteShape = Delete ; 選択中の消しゴム図形を削除する
# EraseToolSelect = S ; 選択ツールに切り替える
# EraseToolBrush = B ; 筆ツールに切り替える
# EraseToolLasso = L ; 囲みツールに切り替える
# EraseToolPolygon = P ; 多角形ツールに切り替える
# EraseToolVLine = V ; 縦線ツールに切り替える
# EraseToolHLine = H ; 横線ツールに切り替える
# EraseToolLine = I ; 直線ツールに切り替える
# EraseToolRect = R ; 矩形ツールに切り替える
# EraseToolEllipse = O ; 楕円ツールに切り替える
# ErasePaintMode = D ; 描画モードに切り替える
# EraseEraseMode = F ; 消去モードに切り替える
# EraseSpacePan = Space ; 押している間だけ画像をパン操作する

[Conceal] ; 隠蔽加工モード
# ConcealExit = Ctrl+M ; 隠蔽加工モードを終了する
# ConcealUndo = Ctrl+Z ; 隠蔽加工編集を元に戻す
# ConcealDeleteShape = Delete ; 選択中の隠蔽図形を削除する
# ConcealPixelGrid = G ; ピクセルグリッド表示を切り替える
# ConcealTypeCycle = T ; 隠蔽タイプを切り替える
# ConcealPreset1 = 1 ; 隠蔽プリセット1を呼び出す
# ConcealPreset2 = 2 ; 隠蔽プリセット2を呼び出す
# ConcealPreset3 = 3 ; 隠蔽プリセット3を呼び出す
# ConcealPreset4 = 4 ; 隠蔽プリセット4を呼び出す
# ConcealPaintMode = D ; 描画モードに切り替える
# ConcealEraseMode = F ; 消去モードに切り替える
# ConcealToolSelect = S ; 選択ツールに切り替える
# ConcealToolBrush = B ; 筆ツールに切り替える
# ConcealToolLasso = L ; 囲みツールに切り替える
# ConcealToolPolygon = P ; 多角形ツールに切り替える
# ConcealToolLine = I ; 直線ツールに切り替える
# ConcealToolVLine = V ; 縦線ツールに切り替える
# ConcealToolHLine = H ; 横線ツールに切り替える
# ConcealToolRect = R ; 矩形ツールに切り替える
# ConcealToolEllipse = O ; 楕円ツールに切り替える
# ConcealSpacePan = Space ; 押している間だけ画像をパン操作する

[Crop] ; 切り取りモード
# CropSpacePan = Space ; 押している間だけ画像をパン操作する
# CropExecute = Ctrl+E ; 切り取りを実行する

[Text] ; テキスト注釈モード
# TextConfirm = Ctrl+T ; テキスト注釈モードを確定または終了する
# TextRedo.1 = Ctrl+Y ; テキスト注釈編集をやり直す
# TextRedo.2 = Ctrl+Shift+Z ; テキスト注釈編集をやり直す
# TextUndo = Ctrl+Z ; テキスト注釈編集を元に戻す
# TextSpacePan = Space ; 押している間だけ画像をパン操作する

[LocalAdjust] ; 補正レイヤー
# LaShowSource = Q ; 元画像表示を切り替える
# LaShowMask = W ; マスク表示を切り替える
# LaPaintAdd = D ; 補正マスクの追加描画モードにする
# LaPaintErase = F ; 補正マスクの消去描画モードにする
# LaToolBrush = B ; 筆ツールに切り替える
# LaToolEdgeBrush = A ; 境界ブラシツールに切り替える
# LaToolGapFill = G ; すき間塗りツールに切り替える
# LaToolLasso = L ; 囲みツールに切り替える
# LaToolPolygon = P ; 多角形ツールに切り替える
# LaToolSelect = S ; 選択ツールに切り替える
# LaToolLine = I ; 直線ツールに切り替える
# LaToolVLine = V ; 縦線ツールに切り替える
# LaToolHLine = H ; 横線ツールに切り替える
# LaToolRect = R ; 矩形ツールに切り替える
# LaToolEllipse = O ; 楕円ツールに切り替える
# LaSpacePan = Space ; 押している間だけ画像をパン操作する
