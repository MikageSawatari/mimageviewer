# FsApplyErase2 = F8 ; 消しゴムマスクスロット2を現在ページに適用する
# FsApplyConceal1 = F9 ; 隠蔽マスクスロット1を現在ページに適用する
# FsApplyConceal2 = F10 ; 隠蔽マスクスロット2を現在ページに適用する
# FsDeleteEraseMask.1 = Shift+F7 ; 現在ページの消しゴムマスクを削除する
# FsDeleteEraseMask.2 = Shift+F8 ; 現在ページの消しゴムマスクを削除する
# FsDeleteConcealMask.1 = Shift+F9 ; 現在ページの隠蔽マスクを削除する
# FsDeleteConcealMask.2 = Shift+F10 ; 現在ページの隠蔽マスクを削除する

[FsVideo] ; 動画フルスクリーン
# VideoExternalPlayer = Shift+Enter ; 現在の動画を外部プレイヤーで開く
# VideoCloseFullscreen = none ; 動画フルスクリーンを閉じて一覧へ戻る
# VideoPlayPause.1 = Space ; 動画の再生または一時停止を切り替える
# VideoPlayPause.2 = Enter ; 動画の再生または一時停止を切り替える
# VideoSeekStart = W ; 動画の先頭へ移動して再生する
# VideoSeekBackSmall = Shift+Left ; 動画を1秒戻す
# VideoSeekForwardSmall = Shift+Right ; 動画を1秒進める
# VideoSeekBackLarge = Ctrl+Left ; 動画を30秒戻す
# VideoSeekForwardLarge = Ctrl+Right ; 動画を30秒進める
# VideoFrameStepBack = Ctrl+Shift+Left ; 動画を1フレーム戻す
# VideoFrameStepForward = Ctrl+Shift+Right ; 動画を1フレーム進める
# VideoVolumeUp = Shift+Up ; 動画音量を上げる
# VideoVolumeDown = Shift+Down ; 動画音量を下げる
# VideoNextFile = Down ; 次のファイルへ移動する
# VideoPrevFile = Up ; 前のファイルへ移動する
# VideoMute = M ; 動画のミュートを切り替える
# VideoLoop = L ; 動画のループ方式を順に切り替える
# VideoMarkerPrev = J ; 前のチャプター/ブックマーク/ピンへ移動する
# VideoMarkerNext = K ; 次のチャプター/ブックマーク/ピンへ移動する
# VideoPin = P ; 現在の再生位置を代表フレームとしてピン留めする
# VideoPerfOverlay = F ; 動画の性能オーバーレイを切り替える
# VideoTileMode = S ; 動画タイルモードを切り替える
# VideoBookmark = B ; 現在の再生位置にブックマークを追加する
# VideoCapture = Ctrl+S ; 現在の動画フレームをキャプチャ保存する
# VideoAddToActiveBook = Ctrl+B ; 現在の動画フレームを追加先の本へ追加する
# VideoAdjustSlot1.1 = Ctrl+1 ; 動画補正スロット1を読み込む
# VideoAdjustSlot1.2 = Ctrl+Numpad1 ; 動画補正スロット1を読み込む
# VideoAdjustSlot2.1 = Ctrl+2 ; 動画補正スロット2を読み込む
# VideoAdjustSlot2.2 = Ctrl+Numpad2 ; 動画補正スロット2を読み込む
# VideoAdjustSlot3.1 = Ctrl+3 ; 動画補正スロット3を読み込む
# VideoAdjustSlot3.2 = Ctrl+Numpad3 ; 動画補正スロット3を読み込む
# VideoAdjustSlot4.1 = Ctrl+4 ; 動画補正スロット4を読み込む
# VideoAdjustSlot4.2 = Ctrl+Numpad4 ; 動画補正スロット4を読み込む
# VideoAdjustSlot5.1 = Ctrl+5 ; 動画補正スロット5を読み込む
# VideoAdjustSlot5.2 = Ctrl+Numpad5 ; 動画補正スロット5を読み込む
# VideoAdjustSlot6.1 = Ctrl+6 ; 動画補正スロット6を読み込む
# VideoAdjustSlot6.2 = Ctrl+Numpad6 ; 動画補正スロット6を読み込む
# VideoAdjustSlot7.1 = Ctrl+7 ; 動画補正スロット7を読み込む
# VideoAdjustSlot7.2 = Ctrl+Numpad7 ; 動画補正スロット7を読み込む
# VideoAdjustSlot8.1 = Ctrl+8 ; 動画補正スロット8を読み込む
# VideoAdjustSlot8.2 = Ctrl+Numpad8 ; 動画補正スロット8を読み込む
# VideoAdjustSlot9.1 = Ctrl+9 ; 動画補正スロット9を読み込む
# VideoAdjustSlot9.2 = Ctrl+Numpad9 ; 動画補正スロット9を読み込む
# VideoAdjustSlot10.1 = Ctrl+0 ; 動画補正スロット10を読み込む
# VideoAdjustSlot10.2 = Ctrl+Numpad0 ; 動画補正スロット10を読み込む
# VideoToggleAudioMode = Z ; 映像を消して音声モード（音楽ビュー）で聴く。音声モード中は動画表示へ戻す

[Erase] ; 消しゴムモード
# EraseConfirm = E ; 消しゴム処理を実行して終了する
# EraseConfirmPolygon = Enter ; 消しゴム多角形を確定する
# EraseUndo = Ctrl+Z ; 消しゴム編集を元に戻す
# EraseDeleteShape = Delete ; 選択中の消しゴム図形を削除する
# EraseToolSelect = S ; 選択ツールに切り替える
# EraseToolBrush = B ; 筆ツールに切り替える
# EraseToolLasso = L ; 囲みツールに切り替える
# EraseToolPolygon = P ; 多角形ツールに切り替える
# EraseToolVLine = V ; 縦線ツールに切り替える
# EraseToolHLine = H ; 横線ツールに切り替える
# EraseToolLine = I ; 直線ツールに切り替える
# EraseToolRect = R ; 矩形ツールに切り替える
# EraseToolEllipse = O ; 楕円ツールに切り替える
# ErasePaintMode = D ; 描画モードに切り替える
# EraseEraseMode = F ; 消去モードに切り替える
# EraseSpacePan = Space ; 押している間だけ画像をパン操作する

[Conceal] ; 隠蔽加工モード
# ConcealExit = Ctrl+M ; 隠蔽加工モードを終了する
# ConcealConfirmPolygon = Enter ; 隠蔽加工の多角形を確定する
# ConcealUndo = Ctrl+Z ; 隠蔽加工編集を元に戻す
# ConcealDeleteShape = Delete ; 選択中の隠蔽図形を削除する
# ConcealPixelGrid = G ; ピクセルグリッド表示を切り替える
# ConcealTypeCycle = T ; 隠蔽タイプを切り替える
# ConcealPreset1.1 = 1 ; 隠蔽プリセット1を呼び出す
# ConcealPreset1.2 = Numpad1 ; 隠蔽プリセット1を呼び出す
# ConcealPreset2.1 = 2 ; 隠蔽プリセット2を呼び出す
# ConcealPreset2.2 = Numpad2 ; 隠蔽プリセット2を呼び出す
# ConcealPreset3.1 = 3 ; 隠蔽プリセット3を呼び出す
# ConcealPreset3.2 = Numpad3 ; 隠蔽プリセット3を呼び出す
# ConcealPreset4.1 = 4 ; 隠蔽プリセット4を呼び出す
# ConcealPreset4.2 = Numpad4 ; 隠蔽プリセット4を呼び出す
# ConcealPaintMode = D ; 描画モードに切り替える
# ConcealEraseMode = F ; 消去モードに切り替える
# ConcealToolSelect = S ; 選択ツールに切り替える
# ConcealToolBrush = B ; 筆ツールに切り替える
# ConcealToolLasso = L ; 囲みツールに切り替える
# ConcealToolPolygon = P ; 多角形ツールに切り替える
# ConcealToolLine = I ; 直線ツールに切り替える
# ConcealToolVLine = V ; 縦線ツールに切り替える
# ConcealToolHLine = H ; 横線ツールに切り替える
# ConcealToolRect = R ; 矩形ツールに切り替える
# ConcealToolEllipse = O ; 楕円ツールに切り替える
# ConcealSpacePan = Space ; 押している間だけ画像をパン操作する

[Crop] ; 切り取りモード
# CropSpacePan = Space ; 押している間だけ画像をパン操作する
# CropExecute = Ctrl+E ; 切り取りを実行する

[Text] ; テキスト注釈モード
# TextConfirm = Ctrl+T ; テキスト注釈モードを確定または終了する
# TextRedo.1 = Ctrl+Y ; テキスト注釈編集をやり直す
# TextRedo.2 = Ctrl+Shift+Z ; テキスト注釈編集をやり直す
# TextUndo = Ctrl+Z ; テキスト注釈編集を元に戻す
# TextSpacePan = Space ; 押している間だけ画像をパン操作する

[LocalAdjust] ; 補正レイヤー
# LaShowSource = Q ; 元画像表示を切り替える
# LaShowMask = W ; マスク表示を切り替える
# LaPaintAdd = D ; 補正マスクの追加描画モードにする
# LaPaintErase = F ; 補正マスクの消去描画モードにする
# LaToolBrush = B ; 筆ツールに切り替える
# LaToolEdgeBrush = A ; 境界ブラシツールに切り替える
# LaToolGapFill = G ; すき間塗りツールに切り替える
# LaToolLasso = L ; 囲みツールに切り替える
# LaToolPolygon = P ; 多角形ツールに切り替える
# LaToolSelect = S ; 選択ツールに切り替える
# LaToolLine = I ; 直線ツールに切り替える
# LaToolVLine = V ; 縦線ツールに切り替える
# LaToolHLine = H ; 横線ツールに切り替える
# LaToolRect = R ; 矩形ツールに切り替える
# LaToolEllipse = O ; 楕円ツールに切り替える
# LaConfirmPolygon = Enter ; 補正レイヤーの多角形マスクを確定する
# LaSpacePan = Space ; 押している間だけ画像をパン操作する
