# mimageviewer keymap.ini.default
#
# Advanced users only.
# Reference only. Do not edit this file.
# This file is overwritten by mimageviewer when built-in defaults change.
# Copy lines to keymap.ini and uncomment them if you want to override defaults.
# The file is loaded once at startup.
#
# Rules:
# - All key definition lines below are commented out by default.
# - Leaving a line commented keeps the built-in default.
# - Uncommenting one line for an action replaces all defaults for that action.
# - Use Action.1, Action.2, Action.3 to bind up to three chords.
# - Use "none" to disable an action.
# - Conflicts are not detected; the first matching handler wins.
# - Press actions can use Ctrl/Shift/Alt plus one normal key.
# - ModifierHold actions accept Ctrl, Shift, or Alt only.
# - KeyHold actions accept one normal key only.
# - Mouse, gamepad, drag-and-drop, OS clipboard shortcuts, IME confirmation,
#   right-click menus, rating F1-F6, Escape/Enter navigation, and most arrow
#   navigation are intentionally fixed.
#
# Examples:
# [FsImage]
# FsSlideshow.1 = P
# FsSlideshow.2 = S
# FsCapture = none
# FsLoupeLockToggle = L
# FsLoupeHold = Ctrl
#
# [Text]
# TextRedo.1 = Ctrl+Y
# TextRedo.2 = Ctrl+Shift+Z

[Global]
# GlobalLocalSearch = Ctrl+F
# GlobalFavSearch = Ctrl+S
# GlobalMetadataSearch = Ctrl+G
# GlobalOpenFolder = Ctrl+O

