# /mimageviewer/ 配下のホスト名を mikage.to (www なし) へ統一する。
#
# www.mikage.to と mikage.to は同じドキュメントルートを配信しているため、
# 同一ページが両ホスト名で検索結果に出て評価が割れていた。
# 2026-08 実測: /mimageviewer/ の表示回数 5,620 のうち 819 (14.6%) が www 側で、
# manual/tut-cache.html は www 側 (84 表示) が非 www (46 表示) を上回っていた。
# 各ページの canonical だけでは収束しなかったため 301 で明示する。
#
# ドキュメントルートではなくこの階層に置いている理由:
#   - 実測した分裂は /mimageviewer/ 配下の話で、ここに置けば過不足なく解ける
#   - ルート直下と他セクション (/radiation/ /juliamo/ など) は別リポジトリの
#     管理なので、そちらの .htaccess やリダイレクト設定に干渉しない
#
# RewriteRule のパターンはこのディレクトリからの相対パスに当たるため、
# 置換先には /mimageviewer/ を明示する。
# mod_rewrite が無い環境で 500 にしないよう IfModule で囲む。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.mikage\.to$ [NC]
  RewriteRule ^(.*)$ https://mikage.to/mimageviewer/$1 [R=301,L]

  # BEGIN GENERATED EFFETUNE REDIRECTS
  # Generated by scripts/gen-effetune-docs.py; do not edit this block.
  # Keep current filenames; missing pages and version roots go to index.html.
  RewriteCond $1 ^(README\.html|analyzer\-analog\-meter\.html|analyzer\-chroma\-spiral\.html|analyzer\-level\-meter\.html|analyzer\-note\-spectrogram\.html|analyzer\-oscilloscope\.html|analyzer\-pitch\-meter\.html|analyzer\-rhythm\-analyzer\.html|analyzer\-spectrogram\.html|analyzer\-spectrum\-analyzer\.html|analyzer\-stereo\-meter\.html|analyzer\.html|basics\-bass\-management\.html|basics\-channel\-divider\.html|basics\-dc\-offset\.html|basics\-fir\-crossover\.html|basics\-matrix\.html|basics\-multichannel\-panel\.html|basics\-mute\.html|basics\-polarity\-inversion\.html|basics\-stereo\-balance\.html|basics\-volume\.html|basics\.html|bus\-function\.html|control\-section\.html|control\.html|controller\-mapping\.html|delay\-delay\.html|delay\-time\-alignment\.html|delay\.html|dynamics\-attack\-tonal\-balance\.html|dynamics\-auto\-leveler\.html|dynamics\-brickwall\-limiter\.html|dynamics\-compressor\.html|dynamics\-expander\.html|dynamics\-gate\.html|dynamics\-multiband\-compressor\.html|dynamics\-multiband\-expander\.html|dynamics\-multiband\-transient\.html|dynamics\-power\-amp\-sag\.html|dynamics\-transient\-shaper\.html|dynamics\.html|eq\-15band\-geq\.html|eq\-15band\-peq\.html|eq\-5band\-dynamic\-eq\.html|eq\-5band\-fir\-peq\.html|eq\-5band\-peq\.html|eq\-band\-pass\-filter\.html|eq\-comb\-filter\.html|eq\-earphone\-cable\-sim\.html|eq\-group\-delay\-eq\.html|eq\-group\-delay\-peq\.html|eq\-hi\-pass\-filter\.html|eq\-lo\-pass\-filter\.html|eq\-loudness\-equalizer\.html|eq\-narrow\-range\.html|eq\-room\-eq\.html|eq\-tilt\-eq\.html|eq\-tonal\-balance\-eq\.html|eq\-tone\-control\.html|eq\.html|images/bus_function\.png|images/icon_64x64\.png|images/screenshot\.png|images/video_thumbnail\.jpg|index\.html|license\.html|lofi\-am\-radio\-simulator\.html|lofi\-bit\-crusher\.html|lofi\-cassette\-artifacts\.html|lofi\-digital\-error\-emulator\.html|lofi\-dsd64\-imd\-simulator\.html|lofi\-fm\-radio\-simulator\.html|lofi\-g726\-simulator\.html|lofi\-gsm\-fr\-simulator\.html|lofi\-hum\-generator\.html|lofi\-md\-simulator\.html|lofi\-mp3\-codec\-simulator\.html|lofi\-noise\-blender\.html|lofi\-sbc\-codec\-simulator\.html|lofi\-simple\-jitter\.html|lofi\-sw\-radio\-simulator\.html|lofi\-tape\-artifacts\.html|lofi\-tv\-audio\-simulator\.html|lofi\-vinyl\-artifacts\.html|lofi\-vinyl\-simulator\.html|lofi\.html|modulation\-auto\-filter\.html|modulation\-auto\-pan\.html|modulation\-chorus\.html|modulation\-doppler\-distortion\.html|modulation\-frequency\-shifter\.html|modulation\-phaser\.html|modulation\-pitch\-shifter\-hq\.html|modulation\-pitch\-shifter\.html|modulation\-rotary\-speaker\.html|modulation\-tremolo\.html|modulation\-wow\-flutter\.html|modulation\.html|others\-oscillator\.html|others\-sfz\-note\-player\.html|others\.html|resonator\-adaptive\-prediction\.html|resonator\-horn\-resonator\-plus\.html|resonator\-horn\-resonator\.html|resonator\-modal\-resonator\.html|resonator\.html|restoration\-click\-remover\.html|restoration\-clip\-restorer\.html|restoration\-hum\-remover\.html|restoration\-noise\-reduction\.html|restoration\.html|reverb\-dattorro\-plate\-reverb\.html|reverb\-fdn\-reverb\.html|reverb\-ir\-reverb\.html|reverb\-rs\-reverb\.html|reverb\.html|saturation\-bandwidth\-extender\.html|saturation\-bass\-extender\.html|saturation\-dynamic\-saturation\.html|saturation\-exciter\.html|saturation\-hard\-clipping\.html|saturation\-harmonic\-distortion\.html|saturation\-multiband\-saturation\.html|saturation\-saturation\.html|saturation\-sub\-synth\.html|saturation\-tube\-simulator\.html|saturation\.html|spatial\-crossfeed\-filter\.html|spatial\-crosstalk\-cancellation\.html|spatial\-ms\-matrix\.html|spatial\-multiband\-balance\.html|spatial\-phase\-select\-eq\.html|spatial\-spatial\-mapper\.html|spatial\-stereo\-blend\.html|spatial\.html|visualizer\.html)$ [OR]
  RewriteCond index.html ^(index\.html)$
  RewriteRule ^manual/effetune/(?!v0\.15\.0(?:/|$))v[0-9]+\.[0-9]+\.[0-9]+(?:-[A-Za-z0-9.-]+)?(?:/(.*))?$ https://mikage.to/mimageviewer/manual/effetune/v0.15.0/%1 [R=301,L]
  # END GENERATED EFFETUNE REDIRECTS
</IfModule>
