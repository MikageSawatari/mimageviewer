/target
/target-*/
# vendoring したクレート (vendor/eframe など) が持ち込む build 出力。
# `/target` はリポジトリ直下しか外さないため、これが無いと vendor 配下の
# target/ が丸ごと追跡されてしまう (2026-08-04 に 850MB 混入させた)。
target/
/testimage
/test_images
mimageviewer.log
# mIV 自身がフォルダへ書く編集情報サイドカー (src/sidecar.rs、「設定のバックアップ」ON 時)。
# samples/ などをビューアで開くと生成されるため、リポジトリ内のどこでも追跡しない。
mimageviewer.dat
bench_thumbs.tsv
/installer/Output
/vendor/pdfium
/vendor/models
/vendor/susie-worker
/vendor/ort
/vendor/ffmpeg
/vendor/vst3sdk
/vendor/vst3-host
/vendor/twemoji
/vendor/bench_baseline.json
/crates/vst3-host/build
/dev/
/testdata/
# Local tooling / scratch (Claude Code, Codex レビューメモ)
/.claude/
/codex-review*.md
# 内部用ローカルドキュメント (公開リポジトリに載せない: 競合分析・他プロジェクトの欠点記載など)
/internal/
# Codex verify / sandbox の一時ディレクトリ (CACHEDIR.TAG のみのスクラッチ)
/codex_verify_*/
# Benchmark output (scripts/bench-overnight.ps1)
/bench_results/
/video-soak-results/
/tools/ffmpeg/
# TensorRT pack DL cache (scripts/setup-tensorrt-pack.ps1)
/vendor/tensorrt-cache/

# TRT pack 配布物 (build_trt_pack の出力、~3 GB)
dist/trt-pack-*/

# 編集用追加パック 配布物 (build_editing_pack の出力) + モデル素材
dist/editing-pack-*/
/vendor/editing-pack/

# ポータブル版 配布物 (build-portable.ps1 の出力、loose-deps zip + 展開フォルダ)
dist/mImageViewer_portable_*/
dist/mImageViewer_portable_*.zip

# 配布成果物・検証素材・各種スクラッチ置き場 (一切 git 管理しない)。
# 上の dist/* 個別パターンは歴史的経緯で残すが、dist/ 配下はすべてビルド出力 /
# テスト素材 / レビューメモ等のスクラッチなので、ディレクトリごと無視する。
/dist/

# 開発中の検証用一時ファイル
/tmp-test/

# マニュアル画像のローカル作業素材
/htdocs/mimageviewer/sozai/bj/

# Python bytecode (scripts/ のヘルパー実行で生成)
__pycache__/

# egui_kittest スナップショット差分の一時生成物 (レビュー用、コミット対象外)
tests/snapshots/*.diff.png
tests/snapshots/*.new.png
tests/snapshots/*.old.png
